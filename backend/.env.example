# Copiez ce fichier en `.env` (jamais committé) et remplissez les valeurs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Générer : python scripts/generate_secret.py   (≥ 32 caractères, aléatoire)
SECRET_KEY=

# Local : SQLite. Production Neon : URL du POOLER (host contenant « -pooler »), en postgresql+asyncpg://
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production Neon : URL DIRECTE (sans « -pooler ») utilisée uniquement par Alembic au démarrage
MIGRATION_DATABASE_URL=

# Clé OpenAI (https://platform.openai.com/api-keys). Sans clé, le tuteur répond en mode dégradé.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
DAILY_LLM_QUOTA=80

# Origines autorisées, séparées par des virgules (URL du front, sans slash final)
CORS_ORIGINS=http://localhost:5173

# Facultatif
SENTRY_DSN=

# --- Mot de passe oublié (e-mail) : laissez SMTP_HOST vide pour désactiver l'envoi ---
# Brevo (offre gratuite) : smtp-relay.brevo.com / 587 ; Gmail : smtp.gmail.com / 587 + mot de passe d'application.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Pédagogie (facultatif) ---
# Vérifie la clé de chaque QCM par un second appel IA (qualité +, coût +1 appel par question).
QUIZ_VERIFY_KEYS=true
# Réutilise les QCM validés entre élèves (économise des appels IA).
QUESTION_BANK_ENABLED=true
