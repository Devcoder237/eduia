# URL publique de l'API (origine seule, sans /api). Ex. : https://eduia-api.onrender.com
# Vide en dev : le proxy Vite redirige /api vers VITE_DEV_PROXY.
VITE_API_URL=
# Cible du proxy de développement
VITE_DEV_PROXY=http://localhost:8080
# Build same-origin (reverse proxy) : mettre true pour autoriser VITE_API_URL vide en production
VITE_ALLOW_SAME_ORIGIN=false
# Facultatif : DSN Sentry (projet « Browser JavaScript »)
VITE_SENTRY_DSN=
# Facultatif : adresse de contact affichée dans les conditions d'utilisation
VITE_CONTACT_EMAIL=
